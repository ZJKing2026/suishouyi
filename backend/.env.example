APP_ENV=dev
DEBUG=true
DATABASE_URL=sqlite:///./suishouyi.db

# 允许跨域的来源，逗号分隔；DEBUG=true 时留空表示放开全部
CORS_ORIGINS=

# 本服务对外的访问地址（工具回调自己时用）
BACKEND_URL=http://127.0.0.1:8000

# 内部接口通行证；留空则每次启动随机生成（多进程部署时必须显式配置同一个值）
INTERNAL_TOKEN=

# AI：切换到真实 DeepSeek
AI_MOCK=false
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 视觉模型：可独立配置为任意 OpenAI 兼容接口（DeepSeek 无视觉模型，默认值仅作占位）
VISION_MOCK=false
VISION_API_KEY=your-deepseek-api-key-here
VISION_BASE_URL=https://api.deepseek.com/v1
VISION_MODEL=gpt-4o-mini

WX_APPID=
WX_SECRET=
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_DAYS=30
