.page {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero {
  text-align: center;
  margin-bottom: 80rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--ink-faint);
}

/* 状态显示 */
.status {
  text-align: center;
  margin-bottom: 80rpx;
}

.status-time {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--ink);
  font-family: monospace;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.status-hint {
  font-size: 26rpx;
  color: var(--ink-faint);
}

/* 录音按钮 */
.record-area {
  display: flex;
  justify-content: center;
  margin-bottom: 80rpx;
}

.record-btn {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.record-btn:active {
  transform: scale(0.95);
}

.record-btn.recording {
  background: var(--danger);
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 12rpx 40rpx rgba(231, 76, 60, 0.3); }
  50% { box-shadow: 0 12rpx 60rpx rgba(231, 76, 60, 0.6); }
}

.record-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}

.record-text {
  font-size: 28rpx;
  font-weight: 500;
}

/* 上传中 */
.uploading {
  text-align: center;
  padding: 40rpx;
}

.uploading-text {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.uploading-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
}

/* 提示 */
.tips {
  margin-top: 40rpx;
  text-align: left;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.tip {
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 2;
}

/* 历史入口 */
.history-entry {
  margin-top: auto;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: var(--ink);
  width: 100%;
  box-sizing: border-box;
}

.arrow {
  font-size: 36rpx;
  color: var(--ink-ghost);
}