

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: var(--ink-ghost);
}

/* 标题区 */
.title-section {
  margin-bottom: 40rpx;
}

.title-input {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
  width: 100%;
}

.meta {
  font-size: 24rpx;
  color: var(--ink-faint);
}

.dot {
  margin: 0 12rpx;
}

/* Section */
.section {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-label {
  font-size: 26rpx;
  color: var(--ink-faint);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.section-header .section-label {
  margin-bottom: 0;
}

.section-toggle {
  font-size: 24rpx;
  color: var(--ink-muted);
}

.summary-content {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.7;
}

.points-content {
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.9;
  white-space: pre-wrap;
}

.transcript-content {
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  white-space: pre-wrap;
  margin-top: 20rpx;
  max-height: 800rpx;
  overflow-y: auto;
}

.transcript-collapsed {
  font-size: 28rpx;
  color: var(--ink-faint);
  line-height: 1.6;
  margin-top: 20rpx;
}

.status-hint {
  text-align: center;
  font-size: 26rpx;
  color: var(--warn);
  padding: 32rpx;
}

/* 底部操作栏 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.action-item:active {
  background: var(--bg);
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-label {
  font-size: 22rpx;
  color: var(--ink-muted);
}

/* 隐藏的 canvas */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
}