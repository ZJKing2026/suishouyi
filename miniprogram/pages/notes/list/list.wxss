

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: var(--ink-ghost);
  font-size: 28rpx;
}

.empty-card {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 80rpx 40rpx;
  text-align: center;
  margin-top: 80rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--ink-faint);
  margin-bottom: 48rpx;
}

.empty-btn {
  display: inline-block;
  padding: 20rpx 48rpx;
  background: var(--ink);
  color: var(--surface);
  font-size: 28rpx;
  border-radius: var(--r-chip);
}

.note-item {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.note-item:active {
  background: var(--bg);
}

.note-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.note-summary {
  font-size: 26rpx;
  color: var(--ink-muted);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.note-tag {
  font-size: 22rpx;
  color: var(--ink-muted);
  background: var(--bg-sunken);
  padding: 6rpx 16rpx;
  border-radius: var(--r-sm);
}

.note-time {
  font-size: 22rpx;
  color: var(--ink-ghost);
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-ghost);
  padding: 32rpx 0;
}

/* 悬浮录音按钮 */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--surface);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.fab:active {
  transform: scale(0.95);
}