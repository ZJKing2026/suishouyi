

/* ========== 顶部 ========== */
.hero { margin-bottom: 40rpx; }

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--ink-faint);
}

/* ========== 空状态 ========== */
.empty-state {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 100rpx 40rpx;
  text-align: center;
  margin-top: 80rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.9;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  margin-bottom: 56rpx;
  white-space: pre-line;
}

.empty-btn {
  display: inline-block;
  padding: 24rpx 64rpx;
  background: var(--ink);
  color: var(--surface);
  font-size: 28rpx;
  border-radius: var(--r-chip);
  font-weight: 500;
}

.empty-btn:active {
  opacity: 0.85;
}

/* ========== 统计卡 ========== */
.stat-card {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 48rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 68rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--ink-faint);
}

.stat-divider {
  width: 1rpx;
  height: 80rpx;
  background: var(--line);
}

/* ========== 提示条 ========== */
.tip-bar {
  display: flex;
  align-items: flex-start;
  background: var(--warn-soft);
  border-radius: var(--r-btn);
  padding: 24rpx 28rpx;
  margin-bottom: 40rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.tip-text {
  font-size: 24rpx;
  color: var(--warn);
  line-height: 1.6;
  flex: 1;
}

/* ========== 文档区 ========== */
.section-title {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

.section-title text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.doc-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.doc-item {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx 28rpx;
}

.doc-item:active {
  background: var(--bg);
}

.doc-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-btn);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.doc-icon-inner {
  font-size: 44rpx;
}

.doc-info {
  flex: 1;
  min-width: 0;
}

.doc-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doc-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.doc-tag {
  font-size: 20rpx;
  color: var(--ink-muted);
  background: var(--bg-sunken);
  padding: 6rpx 14rpx;
  border-radius: var(--r-sm);
}

.doc-status {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--r-sm);
}

.status-done {
  color: var(--ok);
  background: var(--ok-soft);
}

.status-processing {
  color: var(--warn);
  background: var(--warn-soft);
}

.status-failed {
  color: var(--danger);
  background: var(--danger-soft);
}

.list-footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-ghost);
  padding: 40rpx 0;
}

/* ========== 悬浮按钮 ========== */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.25);
  z-index: 50;
}

.fab:active {
  transform: scale(0.92);
}

.fab-plus {
  font-size: 64rpx;
  font-weight: 200;
  line-height: 1;
  margin-top: -6rpx;
}