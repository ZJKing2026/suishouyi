<view class="page">

  <view class="hero">
    <view class="hero-title">工具箱</view>
    <view class="hero-subtitle">自己点着用，一键出结果</view>
  </view>

  <view class="tool-list">
    <view
      class="tool-card"
      wx:for="{{ tools }}"
      wx:key="id"
      data-id="{{ item.id }}"
      bindtap="onTapTool"
    >
      <view class="tool-icon">{{ item.icon }}</view>
      <view class="tool-content">
        <view class="tool-name">{{ item.name }}</view>
        <view class="tool-desc">{{ item.desc }}</view>
      </view>
      <view class="tool-arrow">›</view>
    </view>
  </view>

</view>