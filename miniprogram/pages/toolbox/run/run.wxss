

.hero { margin-bottom: 40rpx; }

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--ink-faint);
}

.card {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
  border: 2rpx dashed var(--ink-ghost);
  border-radius: var(--r-btn);
  background: var(--bg);
  margin-bottom: 32rpx;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 26rpx;
  color: var(--ink-muted);
}

.file-list {
  margin-bottom: 32rpx;
}

.file-item {
  font-size: 26rpx;
  color: var(--ink-soft);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field { margin-bottom: 32rpx; }

.field-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-bottom: 16rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg);
  border-radius: var(--r-btn);
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.field-textarea {
  width: 100%;
  min-height: 180rpx;
  background: var(--bg);
  border-radius: var(--r-btn);
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
}

.field-hint {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 12rpx;
}

.notice {
  font-size: 24rpx;
  color: var(--ink-faint);
  padding: 16rpx 0;
  line-height: 1.6;
}

/* Logo 选择 */
.logo-picker {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-btn);
  border: 2rpx dashed var(--ink-ghost);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo-picker:active { background: var(--line); }
.logo-preview { width: 100%; height: 100%; }
.logo-placeholder {
  font-size: 24rpx;
  color: var(--ink-faint);
  text-align: center;
  padding: 0 20rpx;
}

/* 位置选择 */
.position-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.position-item {
  padding: 16rpx 32rpx;
  background: var(--bg);
  border-radius: var(--r-card);
  font-size: 26rpx;
  color: var(--ink-muted);
}

.position-item.active {
  background: var(--ink);
  color: var(--surface);
}

/* 按钮 */
.btn-primary {
  width: 100%;
  background: var(--ink);
  color: var(--surface);
  font-size: 30rpx;
  border-radius: var(--r-btn);
  border: none;
  padding: 26rpx 0;
  margin-top: 16rpx;
}

.btn-primary[disabled] { background: var(--ink-ghost); }

.btn-secondary {
  width: 100%;
  background: var(--bg-sunken);
  color: var(--ink);
  font-size: 28rpx;
  border-radius: var(--r-btn);
  border: none;
  padding: 24rpx 0;
  margin-top: 20rpx;
}

/* 结果 */
.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ok);
  margin-bottom: 24rpx;
}

.result-image {
  width: 100%;
  border-radius: var(--r-btn);
  margin-bottom: 24rpx;
}

.result-meta {
  font-size: 24rpx;
  color: var(--ink-muted);
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.result-text {
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  word-break: break-all;
  white-space: pre-wrap;
  max-height: 900rpx;
  overflow-y: auto;
  background: var(--bg);
  padding: 24rpx;
  border-radius: var(--r-btn);
  margin-bottom: 16rpx;
}