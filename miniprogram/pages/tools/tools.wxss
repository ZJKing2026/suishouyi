

.hero { margin-bottom: 40rpx; }

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--ink-faint);
}

/* ========== Tab 切换 ========== */
.tabs {
  display: flex;
  background: var(--surface);
  border-radius: var(--r-btn);
  padding: 6rpx;
  margin-bottom: 32rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--ink-muted);
  border-radius: var(--r-sm);
}

.tab-active {
  background: var(--ink);
  color: var(--surface);
  font-weight: 500;
}

/* ========== 空状态 ========== */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: var(--ink-ghost);
  font-size: 28rpx;
}

.empty-card {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--ink-faint);
  margin-bottom: 48rpx;
}

.empty-btn {
  display: inline-block;
  padding: 20rpx 48rpx;
  background: var(--ink);
  color: var(--surface);
  font-size: 28rpx;
  border-radius: var(--r-chip);
}

/* ========== 我的工具列表 ========== */
.tool-item {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.tool-item:active {
  background: var(--bg);
}

.tool-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.tool-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  word-break: break-all;
  padding-right: 16rpx;
}

.tool-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
}

.status-on {
  background: var(--ok-soft);
  color: var(--ok);
}

.status-off {
  background: var(--bg-sunken);
  color: var(--ink-faint);
}

.tool-desc {
  font-size: 26rpx;
  color: var(--ink-muted);
  line-height: 1.6;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-ghost);
  padding: 32rpx 0;
}

/* ========== 工具市场列表 ========== */
.market-item {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.market-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-btn);
  background: var(--bg);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.market-content {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.market-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.market-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 12rpx;
}

.market-category {
  font-size: 20rpx;
  color: var(--ink-faint);
  background: var(--bg-sunken);
  padding: 2rpx 12rpx;
  border-radius: var(--r-sm);
}

.market-desc {
  font-size: 24rpx;
  color: var(--ink-muted);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.market-add {
  padding: 14rpx 28rpx;
  background: var(--ink);
  color: var(--surface);
  font-size: 24rpx;
  border-radius: var(--r-card);
  flex-shrink: 0;
}

.market-add:active {
  opacity: 0.85;
}

.market-added {
  background: var(--ok-soft);
  color: var(--ok);
}

/* ========== FAB 悬浮按钮区 ========== */
.fab-wrap {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: flex-end;
  z-index: 50;
}

.fab {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--surface);
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.15s ease;
}

.fab:active {
  transform: scale(0.95);
}

.fab-small {
  width: 96rpx;
  height: 96rpx;
}

.fab-icon {
  font-size: 44rpx;
  line-height: 1;
}

/* ========== 配置弹窗（保留旧功能） ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.modal-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%) scale(0.9);
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 40rpx 32rpx 32rpx;
  z-index: 101;
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s;
  max-height: 80vh;
  overflow-y: auto;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(-50%) scale(1);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.modal-sub {
  font-size: 26rpx;
  color: var(--ink-faint);
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.config-field {
  margin-bottom: 24rpx;
}

.config-label {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-bottom: 12rpx;
}

.config-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg);
  border-radius: var(--r-btn);
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--ink);
}

.config-help {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-top: 8rpx;
  line-height: 1.5;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: var(--r-btn);
  font-size: 30rpx;
}

.modal-btn-cancel {
  background: var(--bg-sunken);
  color: var(--ink);
}

.modal-btn-confirm {
  background: var(--ink);
  color: var(--surface);
}