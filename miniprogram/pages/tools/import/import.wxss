

/* ========== 头部 ========== */
.hero { margin-bottom: 40rpx; }
.hero-title { font-size: 56rpx; font-weight: 700; color: var(--ink); margin-bottom: 12rpx; letter-spacing: 2rpx; }
.hero-subtitle { font-size: 26rpx; color: var(--ink-faint); }

/* ========== 方式卡片 ========== */
.method-card {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx 28rpx;
  margin-bottom: 16rpx;
  transition: transform 0.15s ease;
}

.method-card:active {
  transform: scale(0.98);
}

/* 主推卡片 - 深色 */
.method-primary {
  background: var(--ink);
}

.method-primary:active {
  background: var(--ink-soft);
}

.method-icon {
  font-size: 44rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-btn);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.method-icon-primary {
  font-size: 44rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-btn);
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.method-body {
  flex: 1;
  min-width: 0;
}

.method-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.method-primary .method-title {
  color: var(--surface);
}

.method-desc {
  font-size: 24rpx;
  color: var(--ink-faint);
  line-height: 1.5;
}

.method-primary .method-desc {
  color: rgba(255, 255, 255, 0.65);
}

.method-arrow {
  font-size: 40rpx;
  color: var(--ink-ghost);
  margin-left: 16rpx;
}

.method-arrow-primary {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 16rpx;
}

/* ========== 折叠小提示 ========== */
.hint-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border-radius: var(--r-btn);
  padding: 24rpx 28rpx;
  margin-top: 40rpx;
}

.hint-bar:active {
  background: var(--bg);
}

.hint-left {
  display: flex;
  align-items: center;
}

.hint-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.hint-text {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}

.hint-arrow {
  font-size: 32rpx;
  color: var(--ink-ghost);
  transition: transform 0.25s;
}

.hint-arrow.arrow-up {
  transform: rotate(90deg);
}

.intro-card {
  background: var(--surface);
  border-radius: var(--r-btn);
  padding: 0 28rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease, margin-top 0.3s ease;
  margin-top: 0;
}

.intro-card.intro-show {
  max-height: 400rpx;
  padding: 24rpx 28rpx;
  margin-top: 16rpx;
}

.intro-line {
  font-size: 24rpx;
  color: var(--ink-muted);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.intro-line:last-child {
  margin-bottom: 0;
}

/* ========== 第 2 步：填内容 ========== */
.back-row {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 32rpx;
}

.back-arrow {
  font-size: 32rpx;
  color: var(--ink);
  margin-right: 8rpx;
}

.back-text {
  font-size: 26rpx;
  color: var(--ink);
}

.current-method {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.current-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.current-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.current-desc {
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.5;
}

/* 表单 */
.field { margin-bottom: 28rpx; }
.field-label { font-size: 26rpx; color: var(--ink-soft); margin-bottom: 12rpx; }

.field-input {
  width: 100%;
  height: 88rpx;
  background: var(--surface);
  border-radius: var(--r-btn);
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.field-textarea {
  width: 100%;
  min-height: 360rpx;
  background: var(--surface);
  border-radius: var(--r-btn);
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.5;
}

.field-textarea.code {
  font-family: monospace;
  font-size: 22rpx;
}

.field-hint { font-size: 22rpx; color: var(--ink-faint); margin-top: 10rpx; }

/* 按钮 */
.btn-primary {
  width: 100%;
  background: var(--ink);
  color: var(--surface);
  font-size: 30rpx;
  border-radius: var(--r-btn);
  border: none;
  padding: 28rpx 0;
  margin-top: 16rpx;
}

.btn-primary[disabled] { background: var(--ink-ghost); }

/* ========== 第 3 步：预览 ========== */
.result-card {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 40rpx 32rpx 32rpx;
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.result-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--ok-soft);
  color: var(--ok);
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.result-count {
  font-size: 28rpx;
  color: var(--ink-muted);
  padding: 20rpx 24rpx;
  background: var(--bg);
  border-radius: var(--r-sm);
}

.count-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 0 6rpx;
}

.preview-label {
  font-size: 24rpx;
  color: var(--ink-faint);
  margin: 32rpx 0 16rpx;
}

.tools-list { max-height: 600rpx; }

.tool-preview {
  background: var(--bg);
  border-radius: var(--r-sm);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.tool-preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.tool-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: monospace;
  word-break: break-all;
  flex: 1;
  margin-right: 12rpx;
}

.tool-method {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm);
  color: var(--surface);
  flex-shrink: 0;
}

.method-GET { background: var(--ok); }
.method-POST { background: var(--info); }
.method-PUT { background: var(--warn); }
.method-DELETE { background: var(--danger); }
.method-PATCH { background: var(--accent); }

.tool-desc {
  font-size: 22rpx;
  color: var(--ink-muted);
  line-height: 1.5;
}

.more-hint {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-faint);
  padding: 16rpx 0 0;
}

.preview-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-ghost {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  background: var(--bg-sunken);
  color: var(--ink);
  font-size: 30rpx;
  border-radius: var(--r-btn);
}

.btn-solid {
  flex: 1.5;
  text-align: center;
  padding: 26rpx 0;
  background: var(--ink);
  color: var(--surface);
  font-size: 30rpx;
  border-radius: var(--r-btn);
}