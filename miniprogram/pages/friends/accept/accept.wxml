<view class="page">

  <view class="hero">
    <view class="hero-title">添加好友</view>
    <view class="hero-subtitle">输入邀请码或扫码添加</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">邀请码</view>
      <input class="field-input" placeholder="粘贴 16 位邀请码" value="{{ code }}" bindinput="onInput" maxlength="32" />
    </view>
    <button class="btn-primary" loading="{{ loading }}" disabled="{{ !code }}" bindtap="onAccept">添加好友</button>
  </view>

  <view class="tips">
    <view class="tips-title">怎么获得邀请码？</view>
    <view class="tips-line">· 让好友在小程序里打开"我的好友" → 点 + → 复制邀请码给你</view>
    <view class="tips-line">· 或者在对话里直接问 AI："帮我生成一个邀请码"</view>
  </view>

</view>