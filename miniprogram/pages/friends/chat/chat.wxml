<view class="page">

  <view class="header-info">
    <view class="friend-name">{{ friendName }}</view>
    <view class="friend-desc">他的 AI 会代他回复</view>
  </view>

  <scroll-view class="msg-list" scroll-y scroll-into-view="{{ scrollToId }}">
    <view class="empty" wx:if="{{ messages.length === 0 }}">还没有消息，打个招呼吧</view>
    <view wx:for="{{ messages }}" wx:key="id" id="msg-{{ item.id }}" class="msg-row {{ item.from_user_id === myId ? 'row-me' : 'row-other' }}">
      <view class="bubble {{ item.from_user_id === myId ? 'bubble-me' : 'bubble-other' }}">
        <view class="bubble-content">{{ item.content }}</view>
        <view class="bubble-time">{{ item.from_ai ? '🤖 AI 代发' : '' }}</view>
      </view>
    </view>
    <view style="height: 40rpx;"></view>
  </scroll-view>

  <view class="action-bar">
    <view class="action-btn" bindtap="onAskViaAI">🙋 让 AI 去问</view>
    <view class="action-btn" bindtap="onStartAIChat">🤖 让 AI 帮我聊</view>
  </view>

  <view class="input-bar">
    <input class="input" placeholder="说点什么..." value="{{ inputText }}" bindinput="onInput" bindconfirm="onSend" confirm-type="send" />
    <view class="send-btn {{ !inputText ? 'send-btn-disabled' : '' }}" bindtap="onSend">发送</view>
  </view>

</view>