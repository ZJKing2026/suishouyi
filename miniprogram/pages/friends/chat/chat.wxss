page { height: 100vh; overflow: hidden; }
.page { height: 100vh; display: flex; flex-direction: column; background: #f7f7f8; }
.header-info { background: #fff; padding: 24rpx 32rpx; border-bottom: 1rpx solid #f0f0f0; text-align: center; flex-shrink: 0; }
.friend-name { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }
.friend-desc { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.msg-list { flex: 1; height: 0; padding: 32rpx 32rpx 0; box-sizing: border-box; }
.empty { text-align: center; padding: 200rpx 0; color: #b0b0b0; font-size: 26rpx; }
.msg-row { display: flex; margin-bottom: 24rpx; }
.row-me { justify-content: flex-end; }
.row-other { justify-content: flex-start; }
.bubble { max-width: 70%; padding: 24rpx 28rpx; border-radius: 24rpx; font-size: 30rpx; line-height: 1.6; word-break: break-all; }
.bubble-me { background: #1a1a1a; color: #fff; border-bottom-right-radius: 8rpx; }
.bubble-other { background: #fff; color: #1a1a1a; border-bottom-left-radius: 8rpx; }
.bubble-content { white-space: pre-wrap; }
.bubble-time { font-size: 20rpx; opacity: 0.5; margin-top: 8rpx; }
.action-bar { display: flex; gap: 16rpx; padding: 16rpx 32rpx; background: #fff; border-top: 1rpx solid #f0f0f0; flex-shrink: 0; }
.action-btn { flex: 1; text-align: center; padding: 20rpx 0; background: #f0f0f2; border-radius: 16rpx; font-size: 28rpx; color: #1a1a1a; }
.input-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; border-top: 1rpx solid #f0f0f0; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); flex-shrink: 0; }
.input { flex: 1; height: 72rpx; background: #f7f7f8; border-radius: 36rpx; padding: 0 28rpx; font-size: 30rpx; }
.send-btn { margin-left: 16rpx; padding: 0 32rpx; height: 72rpx; line-height: 72rpx; background: #1a1a1a; color: #fff; border-radius: 36rpx; font-size: 28rpx; }
.send-btn-disabled { background: #ccc; }