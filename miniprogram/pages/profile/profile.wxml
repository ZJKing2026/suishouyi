<view class="page">

  <!-- 用户信息 -->
  <view class="hero">
    <view class="avatar-wrap" bindtap="onTapAvatar">
      <image wx:if="{{ avatarUrl }}" class="avatar-img" src="{{ avatarUrl }}" mode="aspectFill" />
      <view wx:else class="avatar">{{ userInitial }}</view>
      <view class="avatar-edit">📷</view>
    </view>
    <view class="user-info">
      <view class="nickname-row" bindtap="onEditNickname">
        <view class="nickname">{{ userNickname }}</view>
        <view class="edit-icon">✎</view>
      </view>
      <view class="userid">微信小程序 · 已登录</view>
    </view>
  </view>

  <!-- 使用统计 -->
  <view class="stat-card">
    <view class="stat-item">
      <view class="stat-value">{{ totalTasks }}</view>
      <view class="stat-label">任务总数</view>
    </view>
  </view>

  <!-- 配置状态 -->
  <view class="config-banner {{ isConfigured ? 'config-ok' : 'config-warn' }}" bindtap="onTapApiConfig">
    <view class="config-banner-text">
      <view class="config-banner-title">
        {{ isConfigured ? '✓ AI API 已配置' : '⚠️ 未配置 AI API' }}
      </view>
      <view class="config-banner-sub">
        {{ isConfigured ? ('当前 Key：' + apiKeyMasked) : '点击此处配置你的 API Key' }}
      </view>
    </view>
    <view class="config-banner-arrow">›</view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu">
    <view class="menu-item" bindtap="onTapTools">
      <view class="menu-text">我的工具</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onTapApiConfig">
      <view class="menu-text">AI API 配置</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onTapAbout">
      <view class="menu-text">关于项目</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 退出 -->
  <view class="menu">
    <view class="menu-item" bindtap="onLogout">
      <view class="menu-text menu-danger">退出登录</view>
    </view>
  </view>

  <view class="footer">v0.2.0 · Powered by FastAPI</view>

</view>