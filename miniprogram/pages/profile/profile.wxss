.page {
  min-height: 100vh;
  background: #f7f7f8;
  padding: 32rpx;
  box-sizing: border-box;
}

/* ========== 用户信息卡 ========== */
.hero {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #1a1a1a;
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f2;
}

.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 2rpx solid #f0f0f2;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

.edit-icon {
  font-size: 28rpx;
  color: #999;
}

.userid {
  font-size: 24rpx;
  color: #8a8a8a;
}

/* ========== 统计卡 ========== */
.stat-card {
  display: flex;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8a8a8a;
}

/* ========== 配置状态 ========== */
.config-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.config-ok { background: #e8f7ee; color: #1a7f4b; }
.config-warn { background: #fff4e5; color: #b86b00; }

.config-banner-text { flex: 1; }

.config-banner-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.config-banner-sub {
  font-size: 24rpx;
  opacity: 0.85;
}

.config-banner-arrow {
  font-size: 40rpx;
  opacity: 0.5;
  margin-left: 20rpx;
}

/* ========== 菜单 ========== */
.menu {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child { border-bottom: none; }

.menu-text {
  font-size: 30rpx;
  color: #1a1a1a;
}

.menu-danger { color: #e74c3c; }

.menu-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #b0b0b0;
  padding: 40rpx 0;
}