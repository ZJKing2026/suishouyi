page {
  height: 100vh;
  overflow: hidden;
}

.chat-page {
  height: 100vh;
  display: flex;
  position: relative;
  background: var(--bg);
}

/* ========== 遮罩 ========== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.mask-show {
  opacity: 1;
  pointer-events: auto;
}

/* ========== 抽屉 ========== */
.drawer {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 560rpx;
  background: var(--surface);
  z-index: 101;
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 4rpx 0 20rpx rgba(0, 0, 0, 0.08);
}

.drawer-open {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 100rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.drawer-new {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--surface);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 会话列表 */
.session-list {
  flex: 1;
  height: 0;
  padding: 16rpx 0;
}

.session-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.session-item:active {
  background: var(--bg);
}

.session-active {
  background: var(--bg-sunken);
}

.session-title {
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  font-size: 22rpx;
  color: var(--ink-ghost);
}

.session-empty {
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-ghost);
  padding: 80rpx 40rpx;
}

/* 抽屉底部 */
.drawer-footer {
  border-top: 1rpx solid var(--line);
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.menu-item:active {
  background: var(--bg);
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 28rpx;
  color: var(--ink);
}

/* ========== 主内容 ========== */
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 0;
}

.header {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding-top: env(safe-area-inset-top);
  background: var(--surface);
  border-bottom: 1rpx solid var(--line);
  flex-shrink: 0;
}

.header-left {
  width: 100rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hamburger {
  width: 40rpx;
  height: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hamburger .line {
  width: 100%;
  height: 3rpx;
  background: var(--ink);
  border-radius: 2rpx;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-right {
  width: 100rpx;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  height: 0;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
}

.empty {
  text-align: center;
  padding: 200rpx 0 0;
}

.empty-title {
  font-size: 32rpx;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: var(--ink-ghost);
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
}

.row-user { justify-content: flex-end; }
.row-ai { justify-content: flex-start; }

.bubble {
  max-width: 70%;
  padding: 24rpx 28rpx;
  border-radius: var(--r-card);
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

.bubble-user {
  background: var(--ink);
  color: var(--surface);
  border-bottom-right-radius: 8rpx;
}

.bubble-ai {
  background: var(--surface);
  color: var(--ink);
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 输入区 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.input {
  flex: 1;
  height: 76rpx;
  background: var(--bg);
  border-radius: var(--r-chip);
  padding: 0 32rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.send-btn {
  margin-left: 20rpx;
  padding: 0 36rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: var(--ink);
  color: var(--surface);
  border-radius: var(--r-chip);
  font-size: 30rpx;
}

.send-btn-disabled { background: var(--ink-ghost); }