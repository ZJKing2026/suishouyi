

/* ========== 顶部 ========== */
.hero { margin-bottom: 32rpx; }

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--ink-faint);
}

/* ========== 可折叠提示 ========== */
.hint-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  border-radius: var(--r-btn);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.hint-bar:active {
  background: var(--bg);
}

.hint-left {
  display: flex;
  align-items: center;
}

.hint-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.hint-text {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}

.hint-arrow {
  font-size: 32rpx;
  color: var(--ink-ghost);
  transition: transform 0.25s;
}

.hint-arrow.arrow-up {
  transform: rotate(90deg);
}

/* 展开的说明 */
.intro-card {
  background: var(--surface);
  border-radius: var(--r-btn);
  padding: 0 28rpx;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease, margin-bottom 0.3s ease;
  margin-bottom: 0;
}

.intro-card.intro-show {
  max-height: 400rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.intro-line {
  font-size: 24rpx;
  color: var(--ink-muted);
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.intro-line:last-child {
  margin-bottom: 0;
}

/* ========== 空状态 ========== */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: var(--ink-ghost);
  font-size: 28rpx;
}

.empty-card {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 100rpx 40rpx;
  text-align: center;
  margin-top: 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.9;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--ink-faint);
  line-height: 1.8;
  margin-bottom: 56rpx;
}

.empty-btn {
  display: inline-block;
  padding: 24rpx 64rpx;
  background: var(--ink);
  color: var(--surface);
  font-size: 28rpx;
  border-radius: var(--r-chip);
  font-weight: 500;
}

.empty-btn:active {
  opacity: 0.85;
}

/* ========== 服务器列表 ========== */
.server-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.server-item {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx 28rpx;
}

.server-item:active {
  background: var(--bg);
}

.server-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.server-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  flex: 1;
  word-break: break-all;
  padding-right: 16rpx;
}

.server-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--r-sm);
  flex-shrink: 0;
}

.status-on { background: var(--ok-soft); color: var(--ok); }
.status-off { background: var(--bg-sunken); color: var(--ink-faint); }

.server-url {
  font-size: 22rpx;
  color: var(--ink-faint);
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: monospace;
}

.server-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.server-tools {
  font-size: 24rpx;
  color: var(--ink-muted);
}

.server-refresh {
  font-size: 24rpx;
  color: var(--ink);
  padding: 8rpx 20rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-ghost);
  padding: 40rpx 0;
}

/* ========== FAB ========== */
.fab {
  position: fixed;
  right: 48rpx;
  bottom: 80rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.25);
  z-index: 50;
}

.fab:active {
  transform: scale(0.92);
}

.fab-plus {
  font-size: 64rpx;
  font-weight: 200;
  line-height: 1;
  margin-top: -6rpx;
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s;
}

.modal-mask.show { opacity: 1; pointer-events: auto; }

.modal {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%) scale(0.9);
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 40rpx 32rpx 32rpx;
  z-index: 101;
  opacity: 0;
  pointer-events: none;
  transition: all 0.25s;
  max-height: 80vh;
  overflow-y: auto;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(-50%) scale(1);
}

.modal-large { max-height: 85vh; }

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.modal-sub {
  font-size: 24rpx;
  color: var(--ink-faint);
  margin-bottom: 32rpx;
  line-height: 1.5;
  word-break: break-all;
}

.field { margin-bottom: 24rpx; }
.field-label { font-size: 26rpx; color: var(--ink-soft); margin-bottom: 12rpx; }

.field-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg);
  border-radius: var(--r-btn);
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: var(--r-btn);
  font-size: 30rpx;
}

.modal-btn-cancel { background: var(--bg-sunken); color: var(--ink); }
.modal-btn-confirm { background: var(--ink); color: var(--surface); }

/* ========== 详情工具列表 ========== */
.detail-tools-title {
  font-size: 26rpx;
  color: var(--ink-muted);
  margin-bottom: 16rpx;
}

.detail-tools { max-height: 600rpx; }

.detail-tool {
  background: var(--bg);
  border-radius: var(--r-sm);
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.detail-tool-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
  font-family: monospace;
}

.detail-tool-desc {
  font-size: 22rpx;
  color: var(--ink-muted);
  line-height: 1.5;
}