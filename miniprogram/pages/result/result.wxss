

.card {
  background: var(--surface);
  border-radius: var(--r-card);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--ink-muted);
  background: var(--bg-sunken);
  padding: 6rpx 16rpx;
  border-radius: var(--r-sm);
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 26rpx;
  color: var(--ink-faint);
  margin-bottom: 16rpx;
}

.card-content {
  font-size: 28rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  word-break: break-all;
}

.result-scroll {
  max-height: 800rpx;
}

.result-text {
  font-size: 30rpx;
  color: var(--ink);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.btn-row {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.btn-secondary {
  flex: 1;
  background: var(--bg-sunken);
  color: var(--ink);
  font-size: 30rpx;
  border-radius: var(--r-btn);
  border: none;
  padding: 24rpx 0;
}

.btn-primary {
  flex: 1;
  background: var(--ink);
  color: var(--surface);
  font-size: 30rpx;
  border-radius: var(--r-btn);
  border: none;
  padding: 24rpx 0;
}