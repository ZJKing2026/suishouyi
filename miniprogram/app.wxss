/* ============================================================
 * 随手一下 · 全局设计系统
 *
 * 用法约定：
 *   1. 颜色、字号、间距、圆角、阴影一律从这里取变量，页面 wxss 不再写死数值。
 *   2. 本文件只放「跨页面共用」的布局与原子类；带具体视觉意图的组件样式留在页面内。
 *   3. 新增组件时优先复用下面的变量，避免再引入新的色值或尺寸档位。
 * ============================================================ */

page {
  /* ---------- 色板 ---------- */
  /* 墨色主色阶 */
  --ink:          #17161a;   /* 主色：标题、主按钮、用户气泡 */
  --ink-soft:     #322f36;   /* 次级深色 */
  --ink-muted:    #6b6672;   /* 辅助文字 */
  --ink-faint:    #9c97a3;   /* 弱文字、占位符 */
  --ink-ghost:    #c4bfc9;   /* 分割、禁用 */

  /* 画布与卡片 */
  --bg:           #f6f4f1;   /* 页面底色：暖纸感 */
  --bg-sunken:    #edeae5;   /* 凹陷区：输入框、次级背景 */
  --surface:      #ffffff;   /* 卡片、浮层 */
  --line:         #e8e4dd;   /* 分割线 */
  --line-soft:    #f1eee9;   /* 更弱的分割 */

  /* 强调色：陶土橘 */
  --accent:       #e0623c;
  --accent-soft:  #fdf0ea;
  --accent-deep:  #b5432a;

  /* 语义色 */
  --ok:           #2f7a55;
  --ok-soft:      #e6f4ec;
  --warn:         #a8641a;
  --warn-soft:    #fdf3e3;
  --danger:       #cf3f37;
  --danger-soft:  #fbebe9;
  --info:         #3f6ea8;
  --info-soft:    #eaf0f8;

  /* ---------- 字号阶梯 ---------- */
  --fs-hero:      56rpx;   /* 页面主标题 */
  --fs-title:     40rpx;   /* 区块标题 */
  --fs-subtitle:  32rpx;   /* 卡片标题 */
  --fs-body:      28rpx;   /* 正文 */
  --fs-small:     24rpx;   /* 次要说明 */
  --fs-tiny:      22rpx;   /* 标签、角标 */

  /* ---------- 间距 ---------- */
  --sp-page:      32rpx;   /* 页面左右边距 */
  --sp-lg:        32rpx;
  --sp-md:        24rpx;
  --sp-sm:        16rpx;
  --sp-xs:        8rpx;

  /* ---------- 圆角 ---------- */
  --r-card:       28rpx;   /* 卡片 */
  --r-btn:        20rpx;   /* 按钮 */
  --r-chip:       999rpx;  /* 胶囊 */
  --r-sm:         12rpx;   /* 小元素 */

  /* ---------- 阴影 ---------- */
  --shadow-card:  0 4rpx 20rpx rgba(23, 22, 26, 0.05);
  --shadow-lift:  0 12rpx 32rpx rgba(23, 22, 26, 0.10);
  --shadow-float: 0 8rpx 28rpx rgba(23, 22, 26, 0.18);

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--ink);
  background: var(--bg);
}

/* ============================================================
 * 页面容器
 * 所有页面根节点统一用 .page，边距和底部安全区只在这里定义一次
 * ============================================================ */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--sp-page);
  padding-bottom: calc(var(--sp-page) + env(safe-area-inset-bottom));
  background: var(--bg);
}

/* 底部有固定操作栏的页面，额外留出按钮高度 */
.page-has-action {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ============================================================
 * 原子工具类
 * 只做单一声明，页面里可以自由叠加
 * ============================================================ */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-muted { color: var(--ink-muted); }
.text-faint { color: var(--ink-faint); }
.text-accent { color: var(--accent-deep); }
.text-danger { color: var(--danger); }

.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.text-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 统一点击态：所有可点元素都加这个类，手感一致 */
.tappable {
  transition: opacity 0.12s ease;
}
.tappable:active {
  opacity: 0.6;
}
